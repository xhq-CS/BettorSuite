# Required: pooled PostgreSQL connection string from Neon, Supabase, or another provider.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required: canonical production URL. Vercel preview URLs are allowed automatically.
APP_ORIGIN=https://your-domain.com

# Required to provision the initial administrator at function startup.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-14-characters

LOG_LEVEL=info

# Required for account-recovery emails. Verify EMAIL_FROM in Resend.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=BettorSuite Security <security@your-domain.com>
