{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@11.15.1",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/propedge dev",
    "dev:app": "pnpm --filter @workspace/propedge dev",
    "preview": "pnpm --filter @workspace/propedge serve",
    "vercel-build": "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/propedge build",
    "db:push": "pnpm --filter @workspace/db push",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
